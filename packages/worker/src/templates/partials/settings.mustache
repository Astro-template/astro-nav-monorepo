<div class="max-w-2xl">
  <h2 class="text-2xl font-bold mb-2">站点设置</h2>
  <p class="text-sm opacity-70 mb-6">品牌信息保存后，需点侧边栏「发布」再重新部署前端才会生效。</p>

  <form hx-post="/api/admin/settings" class="card bg-base-100 shadow p-6 space-y-4">
    <label class="form-control w-full">
      <div class="label"><span class="label-text">站点名称（浏览器标题 / 侧边栏标题）</span></div>
      <input name="title" value="{{title}}" required class="input input-bordered w-full" placeholder="例如：xx导航"/>
    </label>

    <label class="form-control w-full">
      <div class="label"><span class="label-text">站点描述（SEO description / 副标题）</span></div>
      <textarea name="description" class="textarea textarea-bordered w-full" rows="2" placeholder="一句话介绍这个导航站">{{description}}</textarea>
    </label>

    <label class="form-control w-full">
      <div class="label"><span class="label-text">Logo 文字（侧边栏 logo，留空则用站点名称）</span></div>
      <input name="logoText" value="{{logoText}}" class="input input-bordered w-full" placeholder="留空默认同站点名称"/>
    </label>

    <button type="submit" class="btn btn-primary">💾 保存</button>
  </form>
</div>
