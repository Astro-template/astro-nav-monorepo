<div class="flex justify-between items-center mb-4">
  <h2 class="text-xl font-bold">分类管理</h2>
</div>

<!-- 新增分类表单 -->
<div class="bg-base-100 rounded-box shadow p-4 mb-4">
  <h3 class="font-bold mb-3">➕ 新增分类</h3>
  <form hx-post="/api/admin/categories" hx-swap="none" class="flex flex-wrap gap-2 items-end">
    <div>
      <label class="text-xs">图标</label>
      <input type="text" name="icon" class="input input-bordered input-sm w-16" placeholder="🔍"/>
    </div>
    <div>
      <label class="text-xs">名称 *</label>
      <input type="text" name="name" required class="input input-bordered input-sm w-40" placeholder="SEO工具"/>
    </div>
    <div>
      <label class="text-xs">Slug *</label>
      <input type="text" name="slug" required class="input input-bordered input-sm w-32" placeholder="seo"/>
    </div>
    <div>
      <label class="text-xs">描述</label>
      <input type="text" name="description" class="input input-bordered input-sm w-48" placeholder="可选描述"/>
    </div>
    <div>
      <label class="text-xs">排序</label>
      <input type="number" name="sort_order" value="0" class="input input-bordered input-sm w-16"/>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">添加</button>
  </form>
</div>

<!-- 分类列表 -->
<div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table table-sm">
    <thead>
      <tr>
        <th>图标</th>
        <th>名称</th>
        <th>Slug</th>
        <th>描述</th>
        <th>网站数</th>
        <th>排序</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      {{#categories}}
      <tr>
        <td class="text-lg">{{icon}}</td>
        <td class="font-medium">{{name}}</td>
        <td class="text-xs font-mono">{{slug}}</td>
        <td class="text-xs text-base-content/60">{{description}}</td>
        <td><span class="badge badge-ghost badge-sm">{{siteCount}}</span></td>
        <td>{{sort_order}}</td>
        <td>
          <button class="btn btn-error btn-xs btn-outline" hx-delete="/api/admin/categories/{{id}}" hx-confirm="确认删除分类「{{name}}」？" hx-swap="none">删除</button>
        </td>
      </tr>
      {{/categories}}
    </tbody>
  </table>
</div>

{{^categories}}
<div class="alert mt-4">暂无分类，请先添加</div>
{{/categories}}
