<div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table table-sm">
    <thead>
      <tr>
        <th>网站</th>
        <th>URL</th>
        <th>状态</th>
        <th>分类</th>
        <th>精选</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      {{#sites}}
      <tr>
        <td class="font-medium">{{title}}</td>
        <td><a href="{{url}}" target="_blank" class="link link-primary text-xs truncate max-w-[200px] inline-block">{{url}}</a></td>
        <td>{{{statusBadge}}}</td>
        <td class="text-xs">{{category_id}}</td>
        <td>{{#featured}}<span class="badge badge-warning badge-xs">⭐</span>{{/featured}}</td>
        <td class="flex gap-1">
          <button class="btn btn-error btn-xs btn-outline" hx-delete="/api/sites/{{id}}" hx-confirm="确认删除？" hx-swap="none">删除</button>
        </td>
      </tr>
      {{/sites}}
    </tbody>
  </table>
</div>
{{^sites}}
<div class="alert">暂无网站数据</div>
{{/sites}}
