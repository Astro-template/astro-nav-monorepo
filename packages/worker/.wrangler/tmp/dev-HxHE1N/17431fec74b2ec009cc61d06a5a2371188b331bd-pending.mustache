<div class="stats shadow mb-4">
  <div class="stat">
    <div class="stat-title">待审核</div>
    <div class="stat-value text-warning">{{pendingCount}}</div>
  </div>
  <div class="stat">
    <div class="stat-title">已通过</div>
    <div class="stat-value text-success">{{approvedCount}}</div>
  </div>
  <div class="stat">
    <div class="stat-title">总计</div>
    <div class="stat-value">{{totalCount}}</div>
  </div>
</div>

{{#hasPending}}
<div class="overflow-x-auto bg-base-100 rounded-box shadow">
  <table class="table table-sm">
    <thead>
      <tr>
        <th>网站</th>
        <th>URL</th>
        <th>分类</th>
        <th>提交时间</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      {{#sites}}
      <tr>
        <td class="font-medium">{{title}}</td>
        <td><a href="{{url}}" target="_blank" class="link link-primary text-xs">{{url}}</a></td>
        <td><span class="badge badge-ghost badge-sm">{{category_id}}</span></td>
        <td class="text-xs">{{created_at}}</td>
        <td class="flex gap-1">
          <button class="btn btn-success btn-xs" hx-put="/api/sites/{{id}}" hx-vals='{"status":"approved"}' hx-swap="none">✓</button>
          <button class="btn btn-error btn-xs btn-outline" hx-put="/api/sites/{{id}}" hx-vals='{"status":"rejected"}' hx-swap="none">✗</button>
        </td>
      </tr>
      {{/sites}}
    </tbody>
  </table>
</div>
{{/hasPending}}

{{^hasPending}}
<div class="alert">🎉 没有待审核的网站</div>
{{/hasPending}}
