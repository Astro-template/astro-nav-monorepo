---
import Layout from '../layouts/Layout.astro';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'https://api.nav.ouraihub.com';
---

<Layout title="提交收录 - Affiliate导航" description="提交您的网站，加入导航收录。">
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <div class="fixed top-0 right-0 left-sidebar h-nav bg-white border-b border-gray-200 z-100 px-4 flex items-center">
    <div class="flex gap-6">
      <a href="/" class="nav-link text-gray-600 no-underline text-[0.95rem] py-2 transition-colors duration-300 relative hover:text-primary">首页</a>
      <a href="/submit" data-active="true" class="nav-link text-gray-600 no-underline text-[0.95rem] py-2 transition-colors duration-300 relative hover:text-primary data-[active=true]:text-primary after:content-[''] after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-primary after:rounded-sm data-[active=true]:after:block after:hidden">提交收录</a>
    </div>
  </div>

  <div class="bg-white p-8 rounded-xl shadow-md mt-20 w-full max-w-2xl mx-auto">
    <h1 class="text-gray-800 mb-6 text-center text-2xl font-semibold">提交网站</h1>

    <form id="submit-form" class="space-y-5">
      <div>
        <label class="block text-gray-800 mb-1 font-medium">网站名称 *</label>
        <input type="text" name="title" required maxlength="100" placeholder="请输入网站名称"
               class="w-full px-3 py-3 border border-gray-200 rounded-md text-base outline-none focus:border-primary" />
      </div>

      <div>
        <label class="block text-gray-800 mb-1 font-medium">网站 URL *</label>
        <input type="url" name="url" required placeholder="https://example.com"
               class="w-full px-3 py-3 border border-gray-200 rounded-md text-base outline-none focus:border-primary" />
      </div>

      <div>
        <label class="block text-gray-800 mb-1 font-medium">一句话描述 * <span class="text-xs text-gray-400">(10-200字)</span></label>
        <textarea name="description" required minlength="10" maxlength="200" rows="3" placeholder="简要介绍这个网站..."
                  class="w-full px-3 py-3 border border-gray-200 rounded-md text-base outline-none focus:border-primary resize-y"></textarea>
      </div>

      <div>
        <label class="block text-gray-800 mb-1 font-medium">分类 *</label>
        <select name="category_id" required id="category-select"
                class="w-full px-3 py-3 border border-gray-200 rounded-md text-base outline-none focus:border-primary">
          <option value="">加载中...</option>
        </select>
      </div>

      <div>
        <label class="block text-gray-800 mb-1 font-medium">Logo URL</label>
        <input type="url" name="logo" placeholder="https://example.com/logo.png（可选）"
               class="w-full px-3 py-3 border border-gray-200 rounded-md text-base outline-none focus:border-primary" />
      </div>

      <div>
        <label class="block text-gray-800 mb-1 font-medium">标签</label>
        <input type="text" name="tags" placeholder="用逗号分隔，如：SEO,免费,Chrome插件"
               class="w-full px-3 py-3 border border-gray-200 rounded-md text-base outline-none focus:border-primary" />
      </div>

      <details class="border border-gray-100 rounded-md p-3">
        <summary class="cursor-pointer text-gray-600 text-sm">提交者信息（可选）</summary>
        <div class="mt-3 space-y-3">
          <input type="text" name="submitter_name" placeholder="你的名字"
                 class="w-full px-3 py-2 border border-gray-200 rounded-md text-sm outline-none focus:border-primary" />
          <input type="email" name="submitter_email" placeholder="你的邮箱"
                 class="w-full px-3 py-2 border border-gray-200 rounded-md text-sm outline-none focus:border-primary" />
          <textarea name="submitter_reason" rows="2" placeholder="推荐理由"
                    class="w-full px-3 py-2 border border-gray-200 rounded-md text-sm outline-none focus:border-primary resize-y"></textarea>
        </div>
      </details>

      <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '1x00000000000000000000AA'}></div>

      <button type="submit" id="submit-btn"
              class="bg-primary text-white border-none px-8 py-4 rounded-md text-base cursor-pointer w-full hover:bg-primary-light disabled:bg-gray-400 disabled:cursor-not-allowed">
        提交
      </button>

      <div id="submit-msg" class="text-center text-sm hidden"></div>
    </form>
  </div>
</Layout>

<script define:vars={{ API_BASE }}>
  const select = document.getElementById('category-select');
  const form = document.getElementById('submit-form');
  const btn = document.getElementById('submit-btn');
  const msg = document.getElementById('submit-msg');

  // Load categories
  fetch(`${API_BASE}/api/categories`)
    .then(r => r.json())
    .then(data => {
      select.innerHTML = '<option value="">请选择分类</option>' +
        data.categories.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
    })
    .catch(() => {
      select.innerHTML = '<option value="">加载失败，请刷新</option>';
    });

  // Submit
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = '提交中...';
    msg.classList.add('hidden');

    const fd = new FormData(form);
    const turnstileToken = fd.get('cf-turnstile-response');
    if (!turnstileToken) {
      msg.textContent = '❌ 请完成验证码';
      msg.className = 'text-center text-sm text-red-600';
      msg.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = '提交';
      return;
    }

    const body = {
      title: fd.get('title'),
      url: fd.get('url'),
      description: fd.get('description'),
      category_id: fd.get('category_id'),
      logo: fd.get('logo') || undefined,
      tags: fd.get('tags') ? fd.get('tags').split(',').map(t => t.trim()).filter(Boolean) : undefined,
      submitter_name: fd.get('submitter_name') || undefined,
      submitter_email: fd.get('submitter_email') || undefined,
      submitter_reason: fd.get('submitter_reason') || undefined,
      turnstile_token: turnstileToken,
    };

    try {
      const res = await fetch(`${API_BASE}/api/sites`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json();

      if (res.ok) {
        msg.textContent = '✅ ' + data.message;
        msg.className = 'text-center text-sm text-green-600';
        form.reset();
      } else {
        msg.textContent = '❌ ' + (data.error || '提交失败');
        msg.className = 'text-center text-sm text-red-600';
      }
    } catch {
      msg.textContent = '❌ 网络错误，请重试';
      msg.className = 'text-center text-sm text-red-600';
    } finally {
      msg.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = '提交';
    }
  });
</script>
