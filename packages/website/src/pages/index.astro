---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import CategoryCard from '../components/CategoryCard.astro';
import { getNavData } from '../utils/config';

const navigationData = await getNavData();
---

<Layout title="Affiliate导航 - 专业的Affiliate营销导航网站" description="专业的Affiliate营销导航网站">
  <Sidebar />
  <main class="page-main">
    <div class="top-nav">
      <div class="nav-links">
        <a href="/" class="nav-link active">首页</a>
        <a href="/submit" class="nav-link">提交收录</a>
      </div>
    </div>

    <div class="search-box">
      <input type="text" placeholder="搜索导航内容..." class="search-input" id="search-input" />
    </div>

    {navigationData.map((category, index) => (
      <CategoryCard category={category} index={index} />
    ))}
  </main>
</Layout>

<style>
  .search-box { margin: 5rem 0 2rem 0; max-width: 600px; }
  .search-input {
    width: 100%; padding: 1rem 1.5rem; border: 2px solid var(--border);
    border-radius: var(--radius-lg); font-size: 1rem; outline: none;
    transition: border-color 0.3s ease;
  }
  .search-input:focus { border-color: var(--accent); }
</style>

<script src="../scripts/search.ts"></script>
